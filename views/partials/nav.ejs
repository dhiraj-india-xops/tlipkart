<header class="bg-red-500 text-white py-4 shadow-lg sticky top-0 z-20">
  <nav class="container mx-auto">

    <!-- Desktop Navigation -->
    <div class="hidden md:flex justify-between items-center">

      <!-- Left Menu -->
      <ul class="flex items-center gap-2">

        <!-- Home -->
        <li>
          <a href="/"
            class="<%= currentPage === 'index' ? 'bg-red-600 font-medium shadow-md' : 'hover:bg-red-400' %> 
                   py-2 px-4 rounded-xl transition duration-300 flex items-center gap-2">
            <span class="text-lg font-semibold tracking-wide">Airbnb</span>
          </a>
        </li>

        <% if (isLoggedIn) { %>

          <% if (user && user.userType === 'guest') { %>
            <li><a href="/homes"
              class="<%= currentPage === 'Home' ? 'bg-red-600 shadow-md font-medium' : 'hover:bg-red-400' %>
              py-2 px-4 rounded-xl transition">Homes</a></li>

            <li><a href="/favourites"
              class="<%= currentPage === 'favourites' ? 'bg-red-600 shadow-md font-medium' : 'hover:bg-red-400' %>
              py-2 px-4 rounded-xl transition">Favourites</a></li>

            <li><a href="/bookings"
              class="<%= currentPage === 'bookings' ? 'bg-red-600 shadow-md font-medium' : 'hover:bg-red-400' %>
              py-2 px-4 rounded-xl transition">Bookings</a></li>

          <% } else { %>

            <li><a href="/host/host-home-list"
              class="<%= currentPage === 'host-homes' ? 'bg-red-600 shadow-md font-medium' : 'hover:bg-red-400' %>
              py-2 px-4 rounded-xl transition">Host Homes</a></li>

            <li><a href="/host/add-home"
              class="<%= currentPage === 'addHome' ? 'bg-red-600 shadow-md font-medium' : 'hover:bg-red-400' %>
              py-2 px-4 rounded-xl transition">Add Home</a></li>

          <% } %>

        <% } %>

      </ul>

      <!-- Right Menu -->
      <ul class="flex items-center gap-2">

        <% if (!isLoggedIn) { %>
          <li>
            <a href="/signup"
              class="<%= currentPage === 'signup' ? 'bg-red-600 shadow-md font-medium' : 'hover:bg-red-400' %>
              py-2 px-4 rounded-xl border border-white transition">
              SignUp
            </a>
          </li>

          <li>
            <a href="/login"
              class="<%= currentPage === 'login' ? 'bg-white text-red-500 font-medium shadow-md' : 'bg-white text-red-500 hover:bg-red-100' %>
              py-2 px-4 rounded-xl transition">
              Login
            </a>
          </li>

        <% } else { %>

          <li>
            <form action="/logout" method="POST">
              <button type="submit"
                class="hover:bg-red-400 py-2 px-4 rounded-xl border border-white transition shadow-md">
                Logout
              </button>
            </form>
          </li>

        <% } %>

      </ul>

    </div>

    <!-- Mobile Navigation (NO HAMBURGER, ALWAYS VISIBLE) -->
    <div class="md:hidden">

      <div class="flex justify-center">
        <a href="/" class="text-xl font-semibold tracking-wide py-2 px-4 bg-red-600 rounded-xl shadow-md">
          Airbnb
        </a>
      </div>

      <!-- Scrolling mobile menu -->
      <ul class="flex overflow-x-auto gap-2 mt-3 pb-2 px-2 snap-x">

        <% if (!isLoggedIn) { %>

          <li><a href="/signup"
            class="whitespace-nowrap bg-red-600 py-2 px-4 rounded-xl shadow-md">SignUp</a></li>
          <li><a href="/login"
            class="whitespace-nowrap bg-white text-red-500 py-2 px-4 rounded-xl shadow-md">Login</a></li>

        <% } else { %>

          <% if (user && user.userType === 'guest') { %>
            <li><a class="whitespace-nowrap bg-red-600 py-2 px-4 rounded-xl shadow-md" href="/homes">Homes</a></li>
            <li><a class="whitespace-nowrap bg-red-600 py-2 px-4 rounded-xl shadow-md" href="/favourites">Favourites</a></li>
            <li><a class="whitespace-nowrap bg-red-600 py-2 px-4 rounded-xl shadow-md" href="/bookings">Bookings</a></li>
          <% } else { %>
            <li><a class="whitespace-nowrap bg-red-600 py-2 px-4 rounded-xl shadow-md" href="/host/host-home-list">Host Homes</a></li>
            <li><a class="whitespace-nowrap bg-red-600 py-2 px-4 rounded-xl shadow-md" href="/host/add-home">Add Home</a></li>
          <% } %>

          <li>
            <form action="/logout" method="POST">
              <button class="whitespace-nowrap bg-red-800 py-2 px-4 rounded-xl shadow-md">
                Logout
              </button>
            </form>
          </li>

        <% } %>

      </ul>

    </div>

  </nav>
</header>
